---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	slug?: string;
};

const { title, description, pubDate, updatedDate, heroImage, draft, slug } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: 840px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 0;
			}
			.prose {
				width: 100%;
				color: #1e293b;
			}
			.title {
				margin-bottom: 2.5rem;
				padding: 0 0 2rem 0;
				border-bottom: 1px solid #e2e8f0;
				text-align: left;
			}
			:global(.prose:has(.blog-header) > .title) {
				display: none;
			}
			:global(.site-header), :global(.blog-footer) {
				display: none;
			}
			:global(aside.ai-editorial-note ~ aside.ai-editorial-note) {
				display: none;
			}
			.title h1 {
				margin: 0 0 1rem 0;
				font-size: clamp(2rem, 3.5vw, 2.75rem);
				line-height: 1.25;
				color: #0f172a;
				font-weight: 800;
				letter-spacing: -0.02em;
			}
			.byline {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				margin-top: 1.25rem;
			}
			.author-info {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.5rem;
			}
			.author-name {
				font-weight: 700;
				color: #0f172a;
				font-size: 1.05rem;
			}
			.author-title {
				color: #64748b;
				font-size: 0.95rem;
			}
			.meta-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.6rem;
				font-size: 0.88rem;
				color: #64748b;
			}
			.last-updated-on {
				font-style: italic;
			}
			.badge-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 0.25rem;
			}
			.badge {
				display: inline-block;
				background: #f1f5f9;
				color: #334155;
				padding: 3px 10px;
				border-radius: 9999px;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.03em;
			}
			.badge-draft {
				background: #fef3c7;
				color: #b45309;
				border: 1px solid #fcd34d;
			}
			.badge-ai {
				background: #f0fdf4;
				color: #166534;
				border: 1px solid #bbf7d0;
				font-size: 0.75rem;
				font-weight: 600;
				padding: 2px 8px;
				border-radius: 9999px;
				display: inline-flex;
				align-items: center;
				gap: 4px;
			}
			.ai-editorial-note {
				margin-top: 3.5rem;
				padding: 1.25rem 1.5rem;
				background-color: #f8fafc;
				border-left: 3px solid #cbd5e1;
				border-radius: 0 8px 8px 0;
				font-size: 0.9rem;
				line-height: 1.6;
				color: #475569;
			}
			.ai-editorial-note p {
				margin: 0;
			}
			.ai-editorial-note strong {
				color: #0f172a;
			}
			/* Dev-only floating editor trigger */
			.dev-edit-bar {
				position: fixed;
				bottom: 1.5rem;
				right: 1.5rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				background: #0f172a;
				color: #ffffff;
				padding: 0.5rem 1rem;
				border-radius: 9999px;
				box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
				z-index: 100;
				font-size: 0.85rem;
				border: 1px solid #334155;
			}
			.dev-edit-bar a {
				color: #38bdf8;
				text-decoration: none;
				font-weight: 700;
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			.dev-edit-bar a:hover {
				color: #7dd3fc;
			}
		</style>
	</head>

	<body>
		<Header />
		{
			import.meta.env.DEV && slug && (
				<div class="dev-edit-bar">
					{draft && <span style="color: #fbbf24; font-weight: 700;">[DRAFT]</span>}
					<a href={`/edit/${slug}`}>✏️ Open Live Editor</a>
				</div>
			)
		}
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="byline">
							<div class="author-info">
								<span class="author-name">Eduardo Oliveira</span>
								<span class="author-title">— Senior Customer Engineer @ Google Cloud</span>
							</div>
							<div class="meta-row">
								<span><FormattedDate date={pubDate} /></span>
								<span>•</span>
								<span>8 min read</span>
								{
									updatedDate && (
										<>
											<span>•</span>
											<span class="last-updated-on">
												Updated on <FormattedDate date={updatedDate} />
											</span>
										</>
									)
								}
								{
									draft && (
										<>
											<span>•</span>
											<span class="badge badge-draft">Draft</span>
										</>
									)
								}
								<span>•</span>
								<span class="badge-ai" title="Human-authored, AI-edited">✍️ Human-authored • AI-edited</span>
							</div>
							<div class="badge-list">
								<span class="badge">Enterprise AI</span>
								<span class="badge">Anthropic</span>
								<span class="badge">Google Cloud</span>
								<span class="badge">Architecture</span>
							</div>
						</div>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
